# AI Scoring (optional, falls back to rule-based scorer without these)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI-writing check (optional). Sapling AI detector; free trial key gives
# 50,000 characters a day. Only adds a review note, never changes a score.
SAPLING_API_KEY=
# How sure the detector must be before a note is shown (0 to 1). Default 0.9
AI_DETECT_THRESHOLD=0.9

# Admin verification key (optional, allows all in dev mode)
ADMIN_KEY=

# Session secret for cookies
SESSION_SECRET=change-me-to-something-random
